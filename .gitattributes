# Normalize line endings across the polyglot monorepo.
* text=auto eol=lf

# Scripts must stay LF (executed on Linux/macOS CI runners + jpackage launchers).
*.sh   text eol=lf
*.bash text eol=lf

# Windows-only scripts stay CRLF.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets — never touch.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.icns binary
*.pdf  binary
*.mp3  binary
*.mp4  binary
*.wav  binary
*.jar  binary
