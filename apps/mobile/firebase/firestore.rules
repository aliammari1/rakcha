rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // User profiles: owner has full access, authenticated users can view profiles
    match /users/{userId} {
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAuthenticated();
      allow write, update, delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Public catalog collections: read-only for public, authenticated write
    match /categoryFilm/{document} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /ActorFilm/{document} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /Film/{document} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /cinema/{document} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /CategoryProduct/{document} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /produit/{document} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /salle/{document} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /Seance/{document} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /serie/{document} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /Event/{document} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /SuggestedEvent/{document} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // User reviews: public read, authenticated author write
    match /review/{document} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // User-specific operational collections: require authenticated session
    match /cart/{document} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /Reservation/{document} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /Favoris/{document} {
      allow read, create, update, delete: if isAuthenticated();
    }
  }
}
