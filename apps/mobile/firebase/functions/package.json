    "brace-expansion": "1.1.18",
    "esbuild": "0.25.0",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "undici": "6.28.0",
    "vite": "6.4.3"
  }
}
