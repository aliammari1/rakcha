{
  "name": "cloud-functions",
  "description": "Firebase Cloud Functions for RAKCHA (incl. the AI cinema concierge)",
  "type": "commonjs",
  "main": "index.js",
  "dependencies": {
    "@langchain/anthropic": "1.5.10",
    "@langchain/core": "1.2.11",
    "@langchain/langgraph": "1.4.15",
    "@mux/mux-node": "^7.3.3",
    "@onesignal/node-onesignal": "^2.0.1-beta2",
    "axios": "1.20.0",
    "braintree": "^3.6.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.1",
    "qs": "6.16.0",
    "razorpay": "^2.8.4",
    "stripe": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^15.12.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
