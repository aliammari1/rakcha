# Mobile app build-time configuration (Flutter dart-define).
#
# These values are injected at build/run time via --dart-define and read in
# source through String.fromEnvironment(...). Do NOT hardcode them in Dart.
#
# Run / build examples:
#   flutter run \
#     --dart-define=FIREBASE_API_KEY=AIzaSyD5K3yznoR8ytbujRi2K4TnRpkL8rQQmcE \
#     --dart-define=GEMINI_API_KEY=<your-gemini-api-key>
#
#   flutter build apk \
#     --dart-define=FIREBASE_API_KEY=... \
#     --dart-define=GEMINI_API_KEY=...
#
# Tip: keep your real values in a local, gitignored file (e.g. apps/mobile/.env)
# and pass them via --dart-define-from-file=apps/mobile/.env on newer Flutter.

# Firebase web/mobile API key. This is a publishable identifier (it is shipped
# in web builds), but it is externalized here rather than committed in source.
# Documented fallback (current project value):
FIREBASE_API_KEY=AIzaSyD5K3yznoR8ytbujRi2K4TnRpkL8rQQmcE

# Google Gemini API key. This IS a secret — provision your own and never commit
# the real value. The previously committed value has been rotated/removed.
GEMINI_API_KEY=
