<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21"
            fx:controller="com.esprit.controllers.cinemas.CinemaStatisticsController"
            prefWidth="1507" prefHeight="855" styleClass="stats-root"
            stylesheets="@../styles/rakcha-unified.css, @../styles/statistics.css">
  <left>
    <fx:include source="/ui/sidebar.fxml"/>
  </left>
  <center>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="stats-scroll">
      <VBox spacing="24" styleClass="stats-page">
        <VBox spacing="4">
          <Label text="Cinema statistics" styleClass="stats-title"/>
          <Label fx:id="scopeLabel" styleClass="stats-subtitle"/>
        </VBox>

        <HBox spacing="18">
          <VBox styleClass="stat-tile" HBox.hgrow="ALWAYS">
            <FontIcon iconLiteral="mdi2m-movie-open-outline" styleClass="stat-icon"/>
            <Label fx:id="cinemasValue" styleClass="stat-value" text="0"/>
            <Label text="Cinemas" styleClass="stat-label"/>
          </VBox>
          <VBox styleClass="stat-tile" HBox.hgrow="ALWAYS">
            <FontIcon iconLiteral="mdi2c-calendar-clock-outline" styleClass="stat-icon"/>
            <Label fx:id="sessionsValue" styleClass="stat-value" text="0"/>
            <Label text="Upcoming sessions" styleClass="stat-label"/>
          </VBox>
          <VBox styleClass="stat-tile" HBox.hgrow="ALWAYS">
            <FontIcon iconLiteral="mdi2t-ticket-confirmation-outline" styleClass="stat-icon"/>
            <Label fx:id="ticketsValue" styleClass="stat-value" text="0"/>
            <Label text="Tickets sold" styleClass="stat-label"/>
          </VBox>
          <VBox styleClass="stat-tile" HBox.hgrow="ALWAYS">
            <FontIcon iconLiteral="mdi2c-cash" styleClass="stat-icon"/>
            <Label fx:id="revenueValue" styleClass="stat-value" text="0.00 TND"/>
            <Label text="Revenue" styleClass="stat-label"/>
          </VBox>
        </HBox>

        <HBox spacing="18">
          <VBox styleClass="chart-card" HBox.hgrow="ALWAYS">
            <Label text="Upcoming sessions per film" styleClass="chart-heading"/>
            <BarChart fx:id="filmChart" legendVisible="false" animated="false" prefHeight="330">
              <xAxis><CategoryAxis/></xAxis>
              <yAxis><NumberAxis minorTickVisible="false" tickUnit="1"/></yAxis>
            </BarChart>
          </VBox>
          <VBox styleClass="chart-card" HBox.hgrow="ALWAYS">
            <Label text="Seats booked per hall (%)" styleClass="chart-heading"/>
            <BarChart fx:id="hallChart" legendVisible="false" animated="false" prefHeight="330">
              <xAxis><CategoryAxis/></xAxis>
              <yAxis><NumberAxis minorTickVisible="false" upperBound="100" autoRanging="false" tickUnit="25"/></yAxis>
            </BarChart>
          </VBox>
        </HBox>
      </VBox>
    </ScrollPane>
  </center>
</BorderPane>
