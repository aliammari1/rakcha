<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Rakcha workspace{% endblock %}</title>
    <link rel="icon" href="{{ asset('img/Logo.png') }}">
    <link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/font-awesome.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/rakcha.css') }}">
    {% block pageStyle %}{% endblock %}
    <script defer src="{{ asset('js/bootstrap.bundle.min.js') }}"></script>
    <script defer src="{{ asset('js/rakcha.js') }}"></script>
</head>
<body>
    <a class="rk-skip" href="#main">Skip to content</a>
    <div class="rk-ws">
        {% include 'layout/_ws_side.html.twig' only %}
        <div class="rk-ws-main">
            <header class="rk-ws-header">
                <button class="rk-iconbtn rk-ws-toggle" type="button" aria-label="Open navigation" data-rk-menu><i class="fa fa-bars"></i></button>
                <span class="rk-crumb">Rakcha / <b>{% block crumb %}Workspace{% endblock %}</b></span>
                <div class="rk-header-actions">
                    {% if app.user %}
                        <span class="rk-crumb">{{ app.user.prenom|default('Member') }}</span>
                    {% endif %}
                    <a class="rk-iconbtn" href="{{ path('app_home_index') }}" aria-label="View site" title="View site"><i class="fa fa-external-link"></i></a>
                </div>
            </header>
            <main class="rk-ws-content" id="main" tabindex="-1">
                {% block backContent %}{% endblock %}
                {# Legacy back templates render their real content in `body`. #}
                {% block body %}{% endblock %}
            </main>
        </div>
    </div>
    {% block footer %}{% endblock %}
    {% block scripts %}{% endblock %}
</body>
</html>
