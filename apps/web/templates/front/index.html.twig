{% extends 'layout/cinema.html.twig' %}

{% block title %}Rakcha — Movies and showtimes{% endblock %}

{% block content %}
    {# 1. Featured carousel #}
    {% if films is not empty %}
    <twig:Carousel id="featured-carousel" class="rk-hero-carousel" fade>
        {% for film in films|slice(0, 3) %}
            <twig:Carousel:Item active="{{ loop.first }}">
                {% include 'ui/_hero_slide.html.twig' with {film: film, showtimes: showtimes} only %}
            </twig:Carousel:Item>
        {% endfor %}
    </twig:Carousel>
    {% endif %}

    {# 2. How it works #}
    <section class="rk-container rk-section rk-section--tight" aria-labelledby="how-title">
        <div class="rk-steps">
            <div class="rk-step"><span>01</span><div><h3>Pick a film</h3><p>Browse the programme and find the right screening for you.</p></div></div>
            <div class="rk-step"><span>02</span><div><h3>Choose a showtime</h3><p>Date, time and cinema together, so you know exactly where you're going.</p></div></div>
            <div class="rk-step"><span>03</span><div><h3>Take your seats</h3><p>See the seating plan, pick your places and you're ready for the movies.</p></div></div>
        </div>
    </section>

    {# 3. Now showing carousel #}
    {% if nowShowing is not empty %}
    <section class="rk-container rk-section rk-section--tight" aria-labelledby="now-title">
        <div class="rk-section-head">
            <div>
                <span class="rk-eyebrow">On screen now</span>
                <h2 class="rk-title" id="now-title">Now showing</h2>
            </div>
            <a class="rk-textlink" href="{{ path('app_listfilms_index') }}">All films <i class="fa fa-arrow-right"></i></a>
        </div>
        <twig:Carousel id="now-carousel" class="rk-film-carousel">
            {% for batch in nowShowing|batch(4) %}
                <twig:Carousel:Item active="{{ loop.first }}">
                    <div class="rk-rail">
                        {% for film in batch %}
                            {% include 'ui/_film_card.html.twig' with {film: film, showtime: showtimes|filter(s => s.idFilm.id == film.id)|first} only %}
                        {% endfor %}
                    </div>
                </twig:Carousel:Item>
            {% endfor %}
        </twig:Carousel>
    </section>
    {% endif %}

    {# 4. Cinemas #}
    {% if cinemas is not empty %}
    <section class="rk-section rk-cinemas" aria-labelledby="cinemas-title">
        <div class="rk-container">
            <div class="rk-section-head">
                <div>
                    <span class="rk-eyebrow">Where we play</span>
                    <h2 class="rk-title" id="cinemas-title">Our cinemas</h2>
                </div>
                <a class="rk-textlink" href="{{ path('app_cinema_liste') }}">All cinemas <i class="fa fa-arrow-right"></i></a>
            </div>
            <div class="rk-cinema-grid">
                {% for cinema in cinemas %}
                    <a class="rk-cinema" href="{{ path('app_planning', {idCinema: cinema.idCinema}) }}">
                        <span class="rk-cinema__logo">
                            {% set logo = cinema.logo|rakcha_media %}
                            {% if logo %}<img src="{{ asset(logo) }}" alt="" loading="lazy">{% else %}<i class="fa fa-video-camera"></i>{% endif %}
                        </span>
                        <strong>{{ cinema.nom }}</strong>
                        <small><i class="fa fa-map-marker"></i> {{ cinema.adresse }}</small>
                        <span class="rk-cinema__go">View programme <i class="fa fa-arrow-right"></i></span>
                    </a>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    {# 5. Coming soon carousel #}
    {% if comingSoon is not empty %}
    <section class="rk-container rk-section" aria-labelledby="soon-title">
        <div class="rk-section-head">
            <div>
                <span class="rk-eyebrow">On the horizon</span>
                <h2 class="rk-title" id="soon-title">Coming soon</h2>
            </div>
        </div>
        <twig:Carousel id="soon-carousel" class="rk-film-carousel">
            {% for batch in comingSoon|batch(4) %}
                <twig:Carousel:Item active="{{ loop.first }}">
                    <div class="rk-rail">
                        {% for film in batch %}
                            {% include 'ui/_film_card.html.twig' with {film: film} only %}
                        {% endfor %}
                    </div>
                </twig:Carousel:Item>
            {% endfor %}
        </twig:Carousel>
    </section>
    {% endif %}

    {# 6. Showtimes #}
    <section class="rk-section rk-showtimes-section" aria-labelledby="showtime-title">
        <div class="rk-container">
            <div class="rk-section-head">
                <div>
                    <span class="rk-eyebrow">Plan your visit</span>
                    <h2 class="rk-title" id="showtime-title">Upcoming showtimes</h2>
                </div>
                <a class="rk-textlink" href="{{ path('app_cinema_liste') }}">Find a cinema <i class="fa fa-arrow-right"></i></a>
            </div>
            {% include 'ui/_programme.html.twig' with {showtimes: showtimes} only %}
        </div>
    </section>
{% endblock %}
