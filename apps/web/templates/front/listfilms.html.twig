{% extends 'baseFront.html.twig' %}

{% block title %}Films — Rakcha{% endblock %}

{% block body %}
    <section class="rk-page-hero">
        <div class="rk-container">
            <span class="rk-eyebrow">The programme</span>
            <h1 class="rk-title">Films at Rakcha</h1>
            <p class="rk-lede">Hover a card to discover cast, trailers and bookmarks. Choose a screening to see the seating plan and pick your seats.</p>
        </div>
    </section>

    <section class="rk-container rk-section rk-section--tight">
        <div class="rk-film-toolbar">
            <label class="rk-topbar__search" style="margin:0;width:min(340px,100%)">
                <i class="fa fa-search" aria-hidden="true"></i>
                <input type="search" id="film-search" placeholder="Search by film or actor" aria-label="Search films">
            </label>
            <div class="rk-filters" data-film-categories>
                <button class="rk-filter is-active" type="button" data-category="all">All films</button>
                {% for category in categorys %}
                    <button class="rk-filter" type="button" data-category="{{ category.nom|lower }}">{{ category.nom }}</button>
                {% endfor %}
            </div>
        </div>

        <div class="rk-flip-grid" data-film-grid>
            {% for film in films %}
                {% set j = loop.index0 %}
                {% set poster = film.image|rakcha_media %}
                {% set filmSeances = seances[j] %}
                {% set avg = averageRatings[j] %}
                <article class="rk-flip" style="animation-delay: {{ j * 55 }}ms"
                         data-film-name="{{ film.nom|lower }}"
                         data-categories="{% for c in film.categorys %}{{ c.nom|lower }} {% endfor %}">
                    <div class="rk-flip__inner">
                        {# Front #}
                        <div class="rk-flip__front">
                            {% if poster %}<img src="{{ asset(poster) }}" alt="{{ film.nom }} poster" loading="lazy">{% endif %}
                            <button type="button" class="rk-flip__bookmark" data-bookmark="{{ j }}" data-film-id="{{ film.id }}" aria-label="Bookmark {{ film.nom }}">
                                <i class="fa fa-bookmark{% if film.isBookmarked %} rk-bookmarked{% endif %}" data-bookmark-icon="{{ j }}"></i>
                            </button>
                            <div class="rk-flip__front-copy">
                                <h3>{{ film.nom }}</h3>
                                <p>
                                    {% if film.annederalisation %}<span>{{ film.annederalisation }}</span>{% endif %}
                                    {% if film.duree %}<span>{{ film.duree|date('G') * 60 + film.duree|date('i') }} min</span>{% endif %}
                                </p>
                                <span class="rk-chip">
                                    {% if avg and avg[0]['rate_avg'] is defined and avg[0]['rate_avg'] %}
                                        <i class="fa fa-star" style="color:var(--gold)"></i> {{ avg[0]['rate_avg']|number_format(1) }}/5
                                    {% else %}
                                        Not rated yet
                                    {% endif %}
                                </span>
                            </div>
                        </div>

                        {# Back — all original features retained #}
                        <div class="rk-flip__back">
                            <button type="button" class="rk-flip__bookmark" data-bookmark="{{ j }}" data-film-id="{{ film.id }}" aria-label="Bookmark {{ film.nom }}">
                                <i class="fa fa-bookmark{% if film.isBookmarked %} rk-bookmarked{% endif %}" data-bookmark-icon="{{ j }}"></i>
                            </button>
                            <h3>{{ film.nom }}</h3>
                            <p class="rk-flip__meta"><span class="rk-eyebrow">Categories</span>
                                {% for category in film.categorys %}
                                    <a href="{{ path('app_category_show', {id: category.id}) }}">{{ category.nom }}</a>{% if not loop.last %}, {% endif %}
                                {% else %}—{% endfor %}
                            </p>
                            <p class="rk-flip__meta"><span class="rk-eyebrow">Actors</span>
                                {% for actor in film.actors %}
                                    <a href="{{ path('app_actor_show', {id: actor.id}) }}">{{ actor.nom }}</a>{% if not loop.last %}, {% endif %}
                                {% else %}—{% endfor %}
                            </p>
                            <p class="rk-flip__desc">{{ film.description|default('No synopsis available.')|striptags|slice(0, 150) }}</p>
                            {% if app.user %}
                                <div class="rk-flip__rating">
                                    <span class="rk-eyebrow">Your rating</span>
                                    <div class="rk-stars" role="radiogroup" aria-label="Rate {{ film.nom }}" data-film-id="{{ film.id }}">
                                        {% set current = ratings[j].rate|default(0) %}
                                        {% for n in 1..5 %}
                                            <label class="rk-star" title="{{ n }} {{ n == 1 ? 'star' : 'stars' }}">
                                                <input type="radio" name="rate-{{ j }}" value="{{ n }}" data-rate="{{ j }}" {% if current >= n %}checked{% endif %}>
                                                <i class="fa fa-star" aria-hidden="true"></i>
                                                <span class="visually-hidden">{{ n }} stars</span>
                                            </label>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                            <div class="rk-flip__actions">
                                <twig:Button size="sm" data-bs-toggle="modal" data-bs-target="#book-{{ j }}"><i class="fa fa-ticket"></i> Reserve</twig:Button>
                                {% if videoUrl[j] is defined and videoUrl[j] %}
                                    <twig:Button size="sm" outline color="primary" data-bs-toggle="modal" data-bs-target="#trailer-{{ j }}"><i class="fa fa-play-circle"></i> Trailer</twig:Button>
                                {% endif %}
                                <twig:Button size="sm" outline color="secondary" data-bs-toggle="modal" data-bs-target="#imdb-{{ j }}"><i class="fa fa-qrcode"></i> IMDb</twig:Button>
                            </div>
                        </div>
                    </div>
                </article>
            {% else %}
                <p class="rk-empty">No films have been added to the catalogue yet.</p>
            {% endfor %}
        </div>
    </section>

    {# Modals #}
    {% for film in films %}
        {% set j = loop.index0 %}
        {% set filmSeances = seances[j] %}

        <div class="modal fade" id="trailer-{{ j }}" tabindex="-1" aria-label="{{ film.nom }} trailer" aria-hidden="true">
            <div class="modal-dialog modal-lg"><div class="modal-content rk-booking">
                <div class="modal-header"><h2 class="rk-title">{{ film.nom }} — trailer</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body"><div class="rk-trailer"><iframe src="{{ videoUrl[j] }}" title="{{ film.nom }} trailer" allow="autoplay; encrypted-media" allowfullscreen loading="lazy"></iframe></div></div>
            </div></div>
        </div>

        <div class="modal fade" id="imdb-{{ j }}" tabindex="-1" aria-label="{{ film.nom }} on IMDb" aria-hidden="true">
            <div class="modal-dialog"><div class="modal-content rk-booking">
                <div class="modal-header"><h2 class="rk-title">{{ film.nom }} on IMDb</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body rk-qr">
                    {% set qrCode = qr_code_result(urls[j]) %}
                    {% if urls[j] and urls[j] != '' %}
                        <a href="{{ urls[j] }}" target="_blank" rel="noopener noreferrer"><img src="{{ qrCode.dataUri }}" alt="QR code for {{ film.nom }} on IMDb" width="220" height="220"></a>
                        <p class="rk-muted">Scan to open the IMDb page</p>
                    {% else %}
                        <img src="{{ qrCode.dataUri }}" alt="No IMDb link available" width="220" height="220">
                        <p class="rk-muted">No IMDb link is available for this film yet.</p>
                    {% endif %}
                </div>
            </div></div>
        </div>

        <div class="modal fade" id="book-{{ j }}" data-bs-backdrop="static" tabindex="-1" aria-labelledby="book-title-{{ j }}" aria-hidden="true">
            <div class="modal-dialog modal-lg"><div class="modal-content rk-booking">
                <div class="modal-header"><h2 class="rk-title" id="book-title-{{ j }}">{{ film.nom }}</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body">
                    <div class="rk-booking__intro"><span class="rk-eyebrow">Book your seats</span><p class="rk-muted">Choose a cinema, a date and then the seats you want.</p></div>
                    {% if filmSeances|length %}
                        <div class="rk-form-grid">
                            <div class="rk-field">
                                <label for="cinema-{{ j }}">Cinema</label>
                                <select id="cinema-{{ j }}" class="rk-cinema-select" data-index="{{ j }}">
                                    <option value="0">Select a cinema</option>
                                    {% set seen = [] %}
                                    {% for seance in filmSeances %}
                                        {% if seance.idCinema.idCinema not in seen %}
                                            {% set seen = seen|merge([seance.idCinema.idCinema]) %}
                                            <option value="{{ seance.idCinema.idCinema }}">{{ seance.idCinema.nom }}</option>
                                        {% endif %}
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="rk-field">
                                <label for="date-{{ j }}">Date &amp; time</label>
                                <select id="date-{{ j }}" class="rk-date-select" data-index="{{ j }}" disabled><option value="0">Select a cinema first</option></select>
                            </div>
                        </div>
                        <div class="rk-price-line"><span>Ticket price</span><strong data-price="{{ j }}">—</strong></div>
                        <div class="rk-seats" data-seats="{{ j }}" aria-live="polite"><p class="rk-muted">Available seats will appear once you pick a screening.</p></div>
                        <div class="rk-booking__summary" data-summary="{{ j }}" hidden>
                            <span data-summary-text="{{ j }}">No seats selected</span>
                            <twig:Button size="sm" color="success">Continue</twig:Button>
                        </div>
                        <script type="application/json" id="seances-{{ j }}">{{ filmSeances|map(s => {id: s.idSeance, cinema: s.idCinema.idCinema, date: s.date|date('D, j M'), time: s.hd|date('H:i'), price: s.prix})|json_encode|raw }}</script>
                    {% else %}
                        <p class="rk-empty">This film has no showtimes yet. Check the programme again soon.</p>
                    {% endif %}
                </div>
            </div></div>
        </div>
    {% endfor %}

    <section class="rk-section rk-cinemas">
        <div class="rk-container">
            <div class="rk-section-head"><div><span class="rk-eyebrow">Good to know</span><h2 class="rk-title">How booking works</h2></div></div>
            <div class="rk-steps">
                <div class="rk-step"><span>01</span><div><h3>Find your film</h3><p>Filter by category or search by title, then hover a card to discover more.</p></div></div>
                <div class="rk-step"><span>02</span><div><h3>Pick a showtime</h3><p>Choose the cinema and the date that suits you. The ticket price updates automatically.</p></div></div>
                <div class="rk-step"><span>03</span><div><h3>Choose your seats</h3><p>Available seats are shown on the room plan. Select the ones you want and continue.</p></div></div>
            </div>
        </div>
    </section>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const term = document.getElementById('film-search');
        term?.addEventListener('input', () => {
            const q = term.value.trim().toLowerCase();
            for (const card of document.querySelectorAll('[data-film-grid] .rk-flip')) card.hidden = q !== '' && !card.dataset.filmName.includes(q);
        });
        for (const chip of document.querySelectorAll('[data-film-categories] .rk-filter')) {
            chip.addEventListener('click', () => {
                for (const other of chip.parentElement.querySelectorAll('.rk-filter')) other.classList.remove('is-active');
                chip.classList.add('is-active');
                const category = chip.dataset.category;
                for (const card of document.querySelectorAll('[data-film-grid] .rk-flip')) card.hidden = category !== 'all' && !card.dataset.categories.includes(category);
            });
        }
        for (const button of document.querySelectorAll('[data-bookmark]')) {
            button.addEventListener('click', event => {
                event.stopPropagation();
                const j = button.dataset.bookmark;
                const filmId = button.dataset.filmId;
                const icons = document.querySelectorAll('[data-bookmark-icon="' + j + '"]');
                const active = icons[0].classList.toggle('rk-bookmarked');
                fetch('{{ path("app_bookmark_film") }}', {
                    method: 'POST', headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
                    body: JSON.stringify({id: Number(filmId), isBookmarked: active}),
                }).catch(() => {});
            });
        }
        for (const star of document.querySelectorAll('[data-rate]')) {
            star.addEventListener('change', () => {
                const group = star.closest('.rk-stars');
                fetch('{{ path("app_rate_film_index") }}', {
                    method: 'POST', headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
                    body: JSON.stringify({filmId: Number(group.dataset.filmId), rate: Number(star.value)}),
                }).catch(() => {});
            });
        }
        for (const cinema of document.querySelectorAll('.rk-cinema-select')) {
            cinema.addEventListener('change', () => {
                const i = cinema.dataset.index;
                const date = document.querySelector('.rk-date-select[data-index="' + i + '"]');
                const list = JSON.parse(document.getElementById('seances-' + i).textContent || '[]');
                date.innerHTML = '<option value="0">Select a date & time</option>' +
                    list.filter(s => String(s.cinema) === cinema.value)
                        .map(s => '<option value="' + s.id + '">' + s.date + ' · ' + s.time + ' — ' + s.price.toFixed(2) + ' TND</option>').join('');
                date.disabled = false;
                document.querySelector('[data-price="' + i + '"]').textContent = '—';
            });
        }
        for (const date of document.querySelectorAll('.rk-date-select')) {
            date.addEventListener('change', () => {
                const i = date.dataset.index;
                const list = JSON.parse(document.getElementById('seances-' + i).textContent || '[]');
                const seance = list.find(s => String(s.id) === date.value);
                if (!seance) return;
                document.querySelector('[data-price="' + i + '"]').textContent = seance.price.toFixed(2) + ' TND';
                const box = document.querySelector('[data-seats="' + i + '"]');
                box.innerHTML = '<div class="rk-view-toggle" role="group" aria-label="Seat view">' +
                        '<button type="button" class="rk-view-btn is-active" data-view="room"><i class="fa fa-cubes"></i> Room view</button>' +
                        '<button type="button" class="rk-view-btn" data-view="plan"><i class="fa fa-th"></i> Plan view</button></div>' +
                    '<div class="rk-screen">SCREEN</div>' +
                    '<div class="rk-seat-legend"><span><i class="rk-legend-dot rk-legend-dot--free"></i> Available</span>' +
                    '<span><i class="rk-legend-dot rk-legend-dot--taken"></i> Taken</span>' +
                    '<span><i class="rk-legend-dot rk-legend-dot--chosen"></i> Your seats</span></div>' +
                    '<div class="rk-room"><div class="rk-seat-grid"></div></div>';
                for (const viewBtn of box.querySelectorAll('.rk-view-btn')) {
                    viewBtn.addEventListener('click', () => {
                        for (const other of box.querySelectorAll('.rk-view-btn')) other.classList.toggle('is-active', other === viewBtn);
                        box.dataset.view = viewBtn.dataset.view;
                    });
                }
                box.dataset.view = 'room';
                fetch('{{ path("app_seance_seats_film") }}', {
                    method: 'POST', headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
                    body: JSON.stringify({seanceId: seance.id}),
                }).then(r => r.json()).then(data => {
                    if (!data.success) { box.innerHTML = '<p class="rk-muted">Seats could not be loaded for this screening.</p>'; return; }
                    const grid = box.querySelector('.rk-seat-grid');
                    let chosen = 0;
                    for (const seat of data.seatsArray) {
                        const taken = seat.status === 'reserve';
                        const button = document.createElement('button');
                        button.type = 'button';
                        button.className = 'rk-seat' + (taken ? ' rk-seat--taken' : '');
                        button.disabled = taken;
                        button.title = taken ? 'Seat ' + seat.id + ' — taken' : 'Seat ' + seat.id;
                        button.setAttribute('aria-label', button.title);
                        const img = document.createElement('img');
                        img.src = '/img/seats/' + (taken ? 'couch.png' : 'armchair.png');
                        img.alt = '';
                        img.loading = 'lazy';
                        button.appendChild(img);
                        button.addEventListener('click', () => {
                            const active = button.classList.toggle('rk-seat--chosen');
                            img.src = '/img/seats/' + (active ? 'sofa.png' : 'armchair.png');
                            chosen = box.querySelectorAll('.rk-seat--chosen').length;
                            const summary = document.querySelector('[data-summary="' + i + '"]');
                            summary.hidden = chosen === 0;
                            summary.querySelector('[data-summary-text]').textContent = chosen + ' ' + (chosen === 1 ? 'seat' : 'seats') + ' selected · ' + (chosen * seance.price).toFixed(2) + ' TND';
                        });
                        grid.appendChild(button);
                    }
                }).catch(() => { box.innerHTML = '<p class="rk-muted">Seats could not be loaded for this screening.</p>'; });
            });
        }
    });
    </script>
{% endblock %}
