{% extends 'baseFront.html.twig' %}

{% block title %}Cinemas — Rakcha{% endblock %}

{% block body %}
    <section class="rk-page-hero">
        <div class="rk-container">
            <span class="rk-eyebrow">Where we play</span>
            <h1 class="rk-title">Cinemas in Tunisia</h1>
            <p class="rk-lede">Pick a venue to see its rooms and the films currently on screen. Every screening shows its date and time before you choose seats.</p>
        </div>
    </section>

    <section class="rk-container rk-section rk-section--tight">
        <div class="rk-section-head">
            <div>
                <span class="rk-eyebrow">{{ cinemas|length }} venues</span>
                <h2 class="rk-title">Find your cinema</h2>
            </div>
            <label class="rk-topbar__search rk-cinema-search" style="margin:0;width:min(320px,60vw)">
                <i class="fa fa-search" aria-hidden="true"></i>
                <input type="search" id="cinema-search" placeholder="Search by name or city" aria-label="Search cinemas">
            </label>
        </div>

        <div class="rk-cinema-grid" data-cinema-grid>
            {% for cinema in cinemas %}
                {% set logo = cinema.logo|rakcha_media %}
                <article class="rk-cinema-card" data-name="{{ (cinema.nom ~ ' ' ~ cinema.adresse)|lower }}">
                    <div class="rk-cinema-card__logo">
                        {% if logo %}<img src="{{ asset(logo) }}" alt="{{ cinema.nom }} logo" loading="lazy">{% else %}<i class="fa fa-video-camera"></i>{% endif %}
                    </div>
                    <div class="rk-cinema-card__body">
                        <twig:Badge color="{{ cinema.statut == 'Accepted' ? 'success' : 'secondary' }}" pill label="{{ cinema.statut }}"></twig:Badge>
                        <h3>{{ cinema.nom }}</h3>
                        <p><i class="fa fa-map-marker"></i> {{ cinema.adresse }}</p>
                        <div class="rk-cinema-card__facts">
                            <span><i class="fa fa-th-large"></i> {{ cinema.salles|length }} rooms</span>
                            <span><i class="fa fa-film"></i> {{ cinema.films|length }} films</span>
                        </div>
                    </div>
                    <a class="rk-btn rk-btn--ghost rk-btn--sm" href="{{ path('app_planning', {idCinema: cinema.idCinema}) }}">View programme</a>
                </article>
            {% else %}
                <p class="rk-empty">No cinemas are listed yet.</p>
            {% endfor %}
        </div>
    </section>

    <section class="rk-section rk-cinemas">
        <div class="rk-container">
            <div class="rk-section-head">
                <div>
                    <span class="rk-eyebrow">Plan your visit</span>
                    <h2 class="rk-title">How it works</h2>
                </div>
            </div>
            <div class="rk-steps">
                <div class="rk-step"><span>01</span><div><h3>Choose a cinema</h3><p>Find a venue above and open its weekly programme.</p></div></div>
                <div class="rk-step"><span>02</span><div><h3>Pick a screening</h3><p>Date, start time and room are shown together so you know what to expect.</p></div></div>
                <div class="rk-step"><span>03</span><div><h3>Choose your seats</h3><p>See the seating plan and pick the places you want before you book.</p></div></div>
            </div>
        </div>
    </section>

    <script>
        document.getElementById('cinema-search')?.addEventListener('input', event => {
            const term = event.target.value.trim().toLowerCase();
            for (const card of document.querySelectorAll('[data-cinema-grid] .rk-cinema-card')) {
                card.hidden = term !== '' && !card.dataset.name.includes(term);
            }
        });
    </script>
{% endblock %}
