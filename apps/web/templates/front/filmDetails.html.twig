{% extends 'baseFront.html.twig' %}

{% block title %}{{ film.nom }} — Rakcha{% endblock %}

{% block body %}
    {% set poster = film.image|rakcha_media %}
    <section class="rk-page-hero rk-film-hero">
        <div class="rk-container rk-film-hero__inner">
            <div class="rk-film-hero__art">
                {% if poster %}<img src="{{ asset(poster) }}" alt="{{ film.nom }} poster" width="360" height="540">{% endif %}
            </div>
            <div class="rk-film-hero__copy">
                <a class="rk-textlink" href="{{ path('app_listfilms_index') }}"><i class="fa fa-arrow-left"></i> All films</a>
                <span class="rk-eyebrow" style="margin-top:18px">Now in the programme</span>
                <h1 class="rk-title">{{ film.nom }}</h1>
                <div class="rk-hero__meta">
                    {% if film.annederalisation %}<span class="rk-chip">{{ film.annederalisation }}</span>{% endif %}
                    {% if film.duree %}<span class="rk-chip">{{ film.duree|date('G') * 60 + film.duree|date('i') }} min</span>{% endif %}
                    <span class="rk-chip"><i class="fa fa-star"></i> {{ averageRating|default(0) }}/5</span>
                    {% for category in film.categorys|slice(0,3) %}<span class="rk-chip">{{ category.nom }}</span>{% endfor %}
                </div>
                <p class="rk-lede">{{ film.description|default('No synopsis has been added for this film yet.')|striptags }}</p>
                <div class="rk-actions" style="margin-top:22px">
                    <a class="rk-btn" href="#screenings"><i class="fa fa-ticket"></i> See showtimes</a>
                    {% if videoUrl %}<button class="rk-btn rk-btn--ghost" type="button" data-bs-toggle="modal" data-bs-target="#trailerModal"><i class="fa fa-play-circle"></i> Watch trailer</button>{% endif %}
                    {% if imdbUrl %}<a class="rk-btn rk-btn--quiet" href="{{ imdbUrl }}" target="_blank" rel="noopener noreferrer">IMDb <i class="fa fa-external-link"></i></a>{% endif %}
                </div>
            </div>
        </div>
    </section>

    <section class="rk-container rk-section rk-section--tight" id="screenings">
        <div class="rk-section-head">
            <div>
                <span class="rk-eyebrow">Plan your visit</span>
                <h2 class="rk-title">Upcoming screenings</h2>
            </div>
        </div>
        {% if showtimes is not empty %}
            <ul class="rk-showtimes">
                {% for showtime in showtimes %}
                    <li class="rk-showtime">
                        <time datetime="{{ showtime.date|date('Y-m-d') }}T{{ showtime.hd|date('H:i') }}">{{ showtime.hd|date('H:i') }}</time>
                        <div><strong>{{ showtime.idCinema.nom }}</strong><small>{{ showtime.date|date('D, j M') }} · {{ showtime.idSalle.nomSalle }}</small></div>
                        <span class="rk-price">{{ showtime.prix|number_format(2) }} TND</span>
                        <a class="rk-btn rk-btn--sm" href="{{ path('app_listfilms_index') }}">Choose seats</a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="rk-empty">No screenings are scheduled for this film yet. Check back soon or browse the full programme.</p>
        {% endif %}
    </section>

    <section class="rk-section rk-cinemas">
        <div class="rk-container">
            <div class="rk-section-head">
                <div><span class="rk-eyebrow">Behind the film</span><h2 class="rk-title">Cast &amp; details</h2></div>
            </div>
            <div class="rk-detail-grid">
                <twig:Card class="rk-panel">
                    <twig:Card:Header tag="h2">Cast</twig:Card:Header>
                    <twig:Card:Body>
                        {% if film.actors|length %}
                            <div class="rk_cast">
                                {% for actor in film.actors %}
                                    <span class="rk-chip">{{ actor.nom }}</span>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="rk-muted">Cast information is not available for this film.</p>
                        {% endif %}
                    </twig:Card:Body>
                </twig:Card>
                <twig:Card class="rk-panel">
                    <twig:Card:Header tag="h2">Categories</twig:Card:Header>
                    <twig:Card:Body>
                        <div class="rk_cast">
                            {% for category in film.categorys %}<span class="rk-chip">{{ category.nom }}</span>{% else %}<span class="rk-muted">No categories listed.</span>{% endfor %}
                        </div>
                    </twig:Card:Body>
                </twig:Card>
            </div>
        </div>
    </section>

    <section class="rk-container rk-section">
        <div class="rk-section-head">
            <div><span class="rk-eyebrow">Keep exploring</span><h2 class="rk-title">More films</h2></div>
            <a class="rk-textlink" href="{{ path('app_listfilms_index') }}">All films <i class="fa fa-arrow-right"></i></a>
        </div>
        <div class="rk-film-grid">
            {% for other in related|filter(f => f.id != film.id)|slice(0,4) %}
                {% include 'ui/_film_card.html.twig' with {film: other} only %}
            {% endfor %}
        </div>
    </section>

    {% if videoUrl %}
    <div class="modal fade" id="trailerModal" tabindex="-1" aria-label="Trailer" aria-hidden="true">
        <div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-body">
            <div class="rk-trailer"><iframe src="{{ videoUrl }}" title="{{ film.nom }} trailer" allowfullscreen loading="lazy"></iframe></div>
        </div></div></div>
    </div>
    {% endif %}
{% endblock %}
