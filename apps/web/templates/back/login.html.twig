<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign in — Rakcha</title>
    <link rel="icon" href="{{ asset('img/Logo.png') }}">
    <link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/font-awesome.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/rakcha.css') }}">
</head>
<body class="rk-auth">
    <div class="rk-auth__card">
        <aside class="rk-auth__aside">
            <a class="rk-side__brand" href="{{ path('app_home_index') }}">
                <img src="{{ asset('img/Logo.png') }}" alt="">
                <span><b>RAKCHA</b><small>Your Cinema Universe</small></span>
            </a>
            <img class="rk-auth__poster" src="{{ asset('img/films/39862.jpg') }}" alt="Featured film: Dachra" width="320" height="480">
            <div class="rk-auth__feature">
                <strong>Featured this week</strong>
                <span>Dachra · 2018 · 1h 32m</span>
            </div>
            <div class="rk-auth__perks">
                <div class="rk-auth__perk"><i class="fa fa-ticket"></i> Tickets</div>
                <div class="rk-auth__perk"><i class="fa fa-television"></i> Streaming</div>
                <div class="rk-auth__perk"><i class="fa fa-star"></i> VIP Access</div>
            </div>
        </aside>

        <main class="rk-auth__main">
            <h1>Welcome back</h1>
            <p class="rk-auth__sub">Enter the world of cinema</p>

            {% if error_message %}
                <div class="rk-alert rk-alert--error"><i class="fa fa-exclamation-circle"></i> The email or password you entered is incorrect.</div>
            {% endif %}

            <div class="rk-auth__divider">Quick access</div>
            <div class="rk-auth__oauth">
                <a class="rk-oauth" href="{{ path('connect_google_start') }}"><i class="fa fa-google"></i> Google</a>
                <a class="rk-oauth" href="{{ path('connect_microsoft_start') }}" style="border-color:#3a7bbf"><i class="fa fa-windows"></i> Microsoft</a>
            </div>

            <div class="rk-auth__divider">or sign in with email</div>
            <form method="post" action="{{ path('app_login') }}">
                <div class="rk-form-grid" style="grid-template-columns:1fr;gap:12px">
                    <div class="rk-field">
                        <label for="email">Email address</label>
                        <input id="email" name="email" type="email" required autocomplete="username" placeholder="name@example.com" value="{{ last_username|default('') }}">
                    </div>
                    <div class="rk-field">
                        <label for="password">Password</label>
                        <input id="password" name="password" type="password" required autocomplete="current-password" placeholder="Enter your password">
                    </div>
                </div>
                <div class="rk-auth__links">
                    <a href="{{ path('app_forgot_password_request') }}">Forgot email?</a>
                    <a href="{{ path('app_forgot_password_request') }}">Reset by SMS</a>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button class="rk-btn rk-btn--block" type="submit" style="min-height:44px">Sign in</button>
            </form>

            <p class="rk-auth__foot">Don't have an account? <a class="rk-textlink" href="{{ path('app_register') }}" style="min-height:0">Create account</a></p>
        </main>
    </div>
</body>
</html>
