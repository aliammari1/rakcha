{% extends 'baseBack.html.twig' %}

{% block crumb %}Cinema approvals{% endblock %}

{% block body %}
    <header class="rk-page-head">
        <div>
            <span class="rk-eyebrow">Administration</span>
            <h1 class="rk-title">Cinema approvals</h1>
            <p class="rk-lede">Review new cinema requests. Accepted venues appear in the public programme.</p>
        </div>
        <twig:Badge color="warning" pill label="{{ cinemas|filter(c => c.statut == 'Pending')|length }} pending"></twig:Badge>
    </header>

    <div class="rk-kpis">
        <twig:Card class="rk-kpi rk-kpi--amber"><i class="fa fa-clock-o"></i><strong>{{ cinemas|filter(c => c.statut == 'Pending')|length }}</strong><span>Pending review</span></twig:Card>
        <twig:Card class="rk-kpi rk-kpi--green"><i class="fa fa-check-circle"></i><strong>{{ cinemas|filter(c => c.statut == 'Accepted')|length }}</strong><span>Approved</span></twig:Card>
        <twig:Card class="rk-kpi rk-kpi--blue"><i class="fa fa-video-camera"></i><strong>{{ cinemas|length }}</strong><span>Total cinemas</span></twig:Card>
    </div>

    <twig:Card class="rk-panel">
        <twig:Card:Header tag="h2" class="rk-card__head"><span>Requests</span></twig:Card:Header>
        <twig:Card:Body>
            <div class="rk-table-wrap">
                <table class="rk-table">
                    <thead>
                        <tr>
                            <th>Cinema</th>
                            <th>Address</th>
                            <th>Status</th>
                            <th class="rk-actions-head">Decision</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for cinema in cinemas %}
                            <tr>
                                <td>
                                    <div class="rk-cell-title">
                                        {% if cinema.logo %}<img src="{{ asset(cinema.logo|rakcha_media) }}" alt="">{% endif %}
                                        <strong>{{ cinema.nom }}</strong>
                                    </div>
                                </td>
                                <td>{{ cinema.adresse }}</td>
                                <td>
                                    <twig:Badge color="{{ cinema.statut == 'Accepted' ? 'success' : 'warning' }}" pill label="{{ cinema.statut }}"></twig:Badge>
                                </td>
                                <td>
                                    <div class="rk-row-actions rk-row-actions--end">
                                        <form method="post" action="{{ path('app_cinema_accept', {'idCinema': cinema.idCinema}) }}" onsubmit="return confirm('Approve this cinema?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('accept' ~ cinema.idCinema) }}">
                                            <twig:Button size="sm" color="success" type="submit">Approve</twig:Button>
                                        </form>
                                        <form method="post" action="{{ path('app_cinema_reject', {'idCinema': cinema.idCinema}) }}" onsubmit="return confirm('Reject this cinema?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ cinema.idCinema) }}">
                                            <twig:Button size="sm" outline color="danger" type="submit">Reject</twig:Button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="4" class="rk-empty-cell">No cinema requests to review.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </twig:Card:Body>
    </twig:Card>
{% endblock %}
