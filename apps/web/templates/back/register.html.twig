<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Create an account — Rakcha</title>
    <link rel="icon" href="{{ asset('img/Logo.png') }}">
    <link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/font-awesome.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/rakcha.css') }}">
</head>
<body class="rk-auth">
    <div class="rk-auth__card rk-auth__card--wide">
        <aside class="rk-auth__aside">
            <a class="rk-side__brand" href="{{ path('app_home_index') }}">
                <img src="{{ asset('img/Logo.png') }}" alt="">
                <span><b>RAKCHA</b><small>Your Cinema Universe</small></span>
            </a>
            <img class="rk-auth__poster" src="{{ asset('img/films/39862.jpg') }}" alt="Featured film: Dachra" width="320" height="480">
            <div class="rk-auth__feature">
                <strong>Join the experience</strong>
                <span>Book tickets, save favourites and pick your seats.</span>
            </div>
            <div class="rk-auth__perks">
                <div class="rk-auth__perk"><i class="fa fa-ticket"></i> Tickets</div>
                <div class="rk-auth__perk"><i class="fa fa-television"></i> Streaming</div>
                <div class="rk-auth__perk"><i class="fa fa-star"></i> VIP Access</div>
            </div>
        </aside>

        <main class="rk-auth__main">
            <span class="rk-eyebrow">New member</span>
            <h1>Create your account</h1>
            <p class="rk-auth__sub">Begin your cinematic journey with Rakcha</p>

            {% for flash_error in app.flashes('verify_email_error') %}
                <twig:Alert color="danger" content="{{ flash_error }}"></twig:Alert>
            {% endfor %}
            {{ form_errors(registrationForm) }}

            {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate', 'class': 'rk-register-form'}}) }}
                <div class="rk-form-grid">
                    <div class="rk-field">{{ form_label(registrationForm.nom) }}{{ form_widget(registrationForm.nom) }}</div>
                    <div class="rk-field">{{ form_label(registrationForm.prenom) }}{{ form_widget(registrationForm.prenom) }}</div>
                    <div class="rk-field">{{ form_label(registrationForm.email) }}{{ form_widget(registrationForm.email) }}</div>
                    <div class="rk-field">{{ form_label(registrationForm.numTelephone) }}{{ form_widget(registrationForm.numTelephone) }}</div>
                    <div class="rk-field">{{ form_label(registrationForm.plainPassword) }}{{ form_widget(registrationForm.plainPassword) }}</div>
                    <div class="rk-field">{{ form_label(registrationForm.role) }}{{ form_widget(registrationForm.role) }}</div>
                    <div class="rk-field">{{ form_label(registrationForm.adresse) }}{{ form_widget(registrationForm.adresse) }}</div>
                    <div class="rk-field">{{ form_label(registrationForm.dateDeNaissance) }}{{ form_widget(registrationForm.dateDeNaissance) }}</div>
                    <div class="rk-field rk-field--full">{{ form_label(registrationForm.photoDeProfil) }}{{ form_widget(registrationForm.photoDeProfil) }}</div>
                </div>
                <div class="rk-terms">{{ form_widget(registrationForm.agreeTerms) }} {{ form_label(registrationForm.agreeTerms) }}</div>
                <twig:Button type="submit" class="rk-btn rk-btn--block" style="min-height:46px">Create account</twig:Button>
            {{ form_end(registrationForm) }}

            <p class="rk-auth__foot">Already have an account? <a class="rk-textlink" href="{{ path('app_login') }}" style="min-height:0">Sign in</a></p>
        </main>
    </div>
</body>
</html>
