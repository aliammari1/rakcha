{% extends 'baseBack.html.twig' %}
{% import 'back/macros.html.twig' as macros %}

{% block crumb %}Showtimes{% endblock %}

{% block body %}
    <header class="rk-page-head">
        <div>
            <span class="rk-eyebrow">Programming</span>
            <h1 class="rk-title">Showtimes</h1>
            <p class="rk-lede">Schedule a film in one of your rooms, then check the date, time and price at a glance.</p>
        </div>
        <twig:Button data-bs-toggle="modal" data-bs-target="#staticBackdrop" class="rk-btn">Schedule a film</twig:Button>
    </header>

    {{ macros.display_notifications_noty('success', app.flashes('seances')) }}
    {{ macros.display_form_notifications_noty(form) }}
    {% if updateform is defined %}{{ macros.display_form_notifications_noty(updateform) }}{% endif %}

    <div class="rk-kpis">
        <twig:Card class="rk-kpi rk-kpi--maroon"><i class="fa fa-clock-o"></i><strong>{{ seances|length }}</strong><span>Sessions</span></twig:Card>
        <twig:Card class="rk-kpi rk-kpi--blue"><i class="fa fa-film"></i><strong>{{ films|length }}</strong><span>Films</span></twig:Card>
        <twig:Card class="rk-kpi rk-kpi--green"><i class="fa fa-video-camera"></i><strong>{{ cinemas|length }}</strong><span>Cinemas</span></twig:Card>
        <twig:Card class="rk-kpi rk-kpi--amber"><i class="fa fa-ticket"></i><strong>{{ seances|length > 0 ? (seances|first).prix : 0 }} TND</strong><span>Entry price</span></twig:Card>
    </div>

    <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            {{ macros.render_modal_form(form, path('app_seance_new'), 'Create Seance') }}
        </div>
    </div>

    <twig:Card class="rk-panel">
        <twig:Card:Header tag="h2" class="rk-card__head">
            <span>Programme</span>
            <small class="rk-muted">{{ seances|length }} {{ seances|length == 1 ? 'screening' : 'screenings' }}</small>
        </twig:Card:Header>
        <twig:Card:Body>
            <div class="rk-table-wrap">
                <table class="rk-table">
                    <thead>
                        <tr>
                            <th>Cinema</th>
                            <th>Film</th>
                            <th>Room</th>
                            <th>Starts</th>
                            <th>Ends</th>
                            <th>Date</th>
                            <th>Price</th>
                            <th class="rk-actions-head">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for seance in seances %}
                            <tr>
                                <td>
                                    <div class="rk-cell-title">
                                        {% for cinema in cinemas %}
                                            {% if cinema.idCinema == seance.idCinema.idCinema %}
                                                {% if cinema.logo %}<img src="{{ asset(cinema.logo|rakcha_media) }}" alt="">{% endif %}
                                                <strong>{{ cinema.nom }}</strong>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </td>
                                <td>{{ seance.idFilm.nom }}</td>
                                <td>{{ seance.idSalle.nomSalle }}</td>
                                <td><strong>{{ seance.hd|date('H:i') }}</strong></td>
                                <td>{{ seance.hf|date('H:i') }}</td>
                                <td>{{ seance.date|date('D, j M Y') }}</td>
                                <td><span class="rk-price">{{ seance.prix }} TND</span></td>
                                <td>
                                    <div class="rk-row-actions">
                                        <twig:Button size="sm" outline color="primary" data-bs-toggle="modal" data-bs-target="#seance-edit-{{ loop.index0 }}">Edit</twig:Button>
                                        <form method="post" action="{{ path('app_seance_delete', {'idSeance': seance.idSeance}) }}" onsubmit="return confirm('Delete this session?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ seance.idSeance) }}">
                                            <twig:Button size="sm" outline color="danger" type="submit">Delete</twig:Button>
                                        </form>
                                    </div>
                                    <div class="modal fade" id="seance-edit-{{ loop.index0 }}" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            {% if formUpdateNumber is not defined or loop.index0 != formUpdateNumber %}
                                                {{ macros.render_modal_form(updateForms[loop.index0], path('app_seance_edit', {'idSeance': seance.idSeance, 'formUpdateNumber': loop.index0}), 'Edit Seance') }}
                                            {% else %}
                                                {{ macros.render_modal_form(updateform, path('app_seance_edit', {'idSeance': seance.idSeance, 'formUpdateNumber': loop.index0}), 'Edit Seance') }}
                                            {% endif %}
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="8" class="rk-empty-cell">No sessions scheduled yet. Use “Schedule a film” to add the first one.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </twig:Card:Body>
    </twig:Card>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const cinema = document.querySelector('#seance_idCinema');
            if (!cinema) return;
            cinema.addEventListener('change', function () {
                const form = this.closest('form');
                const data = new URLSearchParams({[this.name]: this.value});
                fetch(form.action, {method: form.getAttribute('method') || 'POST', body: data})
                    .then(r => r.text())
                    .then(html => {
                        const doc = new DOMParser().parseFromString(html, 'text/html');
                        for (const id of ['seance_idSalle', 'seance_idFilm']) {
                            const fresh = doc.querySelector('#' + id);
                            const current = document.querySelector('#' + id);
                            if (fresh && current) current.replaceWith(fresh);
                        }
                    });
            });
        });
        {% if hasErrorsCreate is defined %}new bootstrap.Modal('#staticBackdrop', {keyboard: false}).show();{% endif %}
        {% if formUpdateNumber is defined %}new bootstrap.Modal('#seance-edit-{{ formUpdateNumber }}', {keyboard: false}).show();{% endif %}
    </script>
{% endblock %}
