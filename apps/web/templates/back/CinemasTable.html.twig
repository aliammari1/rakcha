{% extends 'baseBack.html.twig' %}
{% import 'back/macros.html.twig' as macros %}

{% block crumb %}Cinemas{% endblock %}

{% block body %}
    <header class="rk-page-head">
        <div>
            <span class="rk-eyebrow">Cinema management</span>
            <h1 class="rk-title">Your cinemas</h1>
            <p class="rk-lede">Manage the venues you look after, their rooms and the films you schedule.</p>
        </div>
        <twig:Button data-bs-toggle="modal" data-bs-target="#staticBackdrop" class="rk-btn">Add a cinema</twig:Button>
    </header>

    {{ macros.display_notifications_noty('success', app.flashes('cinemas')) }}
    {{ macros.display_form_notifications_noty(form) }}
    {% if updateform is defined %}{{ macros.display_form_notifications_noty(updateform) }}{% endif %}

    <div class="rk-kpis">
        <twig:Card class="rk-kpi rk-kpi--maroon">
            <i class="fa fa-video-camera"></i>
            <strong>{{ cinemas|length }}</strong>
            <span>Cinemas</span>
        </twig:Card>
        <twig:Card class="rk-kpi rk-kpi--green">
            <i class="fa fa-check-circle"></i>
            <strong>{{ cinemas|filter(c => c.statut == 'Accepted')|length }}</strong>
            <span>Active</span>
        </twig:Card>
        <twig:Card class="rk-kpi rk-kpi--amber">
            <i class="fa fa-clock-o"></i>
            <strong>{{ cinemas|filter(c => c.statut == 'Pending')|length }}</strong>
            <span>Pending review</span>
        </twig:Card>
        <twig:Card class="rk-kpi rk-kpi--blue">
            <i class="fa fa-users"></i>
            <strong>1</strong>
            <span>Manager</span>
        </twig:Card>
    </div>

    <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">{{ macros.render_modal_form(form, path('app_cinema_new'), 'Create Cinema') }}</div>
    </div>

    <twig:Card class="rk-panel">
        <twig:Card:Header tag="h2" class="rk-card__head">
            <span>Cinema directory</span>
            <small class="rk-muted">{{ cinemas|length }} {{ cinemas|length == 1 ? 'venue' : 'venues' }}</small>
        </twig:Card:Header>
        <twig:Card:Body>
            <div class="rk-table-wrap">
                <table class="rk-table">
                    <thead>
                        <tr>
                            <th>Cinema</th>
                            <th>Address</th>
                            <th>Status</th>
                            <th>Rooms</th>
                            <th class="rk-actions-head">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for cinema in cinemas %}
                            <tr>
                                <td>
                                    <div class="rk-cell-title">
                                        {% if cinema.logo %}<img src="{{ asset(cinema.logo|rakcha_media) }}" alt="" loading="lazy">{% endif %}
                                        <strong>{{ cinema.nom }}</strong>
                                    </div>
                                </td>
                                <td>{{ cinema.adresse }}</td>
                                <td>
                                    <twig:Badge color="{{ cinema.statut == 'Accepted' ? 'success' : 'warning' }}" pill label="{{ cinema.statut }}"></twig:Badge>
                                </td>
                                <td>{{ cinema.salles|length }}</td>
                                <td>
                                    <div class="rk-row-actions">
                                        <form method="post" action="{{ path('app_salle_index', {'idCinema': cinema.idCinema}) }}">
                                            <twig:Button size="sm" outline color="secondary">Rooms</twig:Button>
                                        </form>
                                        <twig:Button size="sm" outline color="primary" data-bs-toggle="modal" data-bs-target="#cinema-edit-{{ i }}">Edit</twig:Button>
                                        <form method="post" action="{{ path('app_cinema_delete', {'idCinema': cinema.idCinema}) }}" onsubmit="return confirm('Delete this cinema?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ cinema.idCinema) }}">
                                            <twig:Button size="sm" outline color="danger" type="submit">Delete</twig:Button>
                                        </form>
                                    </div>
                                    <div class="modal fade" id="cinema-edit-{{ loop.index0 }}" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            {{ macros.render_modal_form(updateForms[loop.index0], path('app_cinema_edit', {'idCinema': cinema.idCinema, 'formUpdateNumber': loop.index0}), 'Edit Cinema') }}
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="rk-empty-cell">No cinemas have been assigned to you yet. Use “Add a cinema” to create one.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </twig:Card:Body>
    </twig:Card>

    {% if hasErrorsCreate is defined %}
        <script>
            new bootstrap.Modal('#staticBackdrop', {keyboard: false}).show();
        </script>
    {% endif %}
{% endblock %}
