{% extends 'baseBack.html.twig' %}
{% import 'back/macros.html.twig' as macros %}

{% block crumb %}Users{% endblock %}

{% block body %}
    <header class="rk-page-head">
        <div>
            <span class="rk-eyebrow">Administration</span>
            <h1 class="rk-title">Users</h1>
            <p class="rk-lede">Manage accounts and review the cinema requests submitted by managers.</p>
        </div>
        <twig:Button data-bs-toggle="modal" data-bs-target="#staticBackdrop" class="rk-btn">Add a user</twig:Button>
    </header>

    {{ macros.display_notifications_noty('success', app.flashes('users')) }}
    {{ macros.display_form_notifications_noty(form) }}
    {% if updateform is defined %}{{ macros.display_form_notifications_noty(updateform) }}{% endif %}

    <div class="rk-kpis">
        <twig:Card class="rk-kpi rk-kpi--blue"><i class="fa fa-users"></i><strong>{{ users|length }}</strong><span>Accounts</span></twig:Card>
        <twig:Card class="rk-kpi rk-kpi--maroon"><i class="fa fa-user-shield"></i><strong>{{ users|filter(u => u.role == 'admin')|length }}</strong><span>Admins</span></twig:Card>
        <twig:Card class="rk-kpi rk-kpi--green"><i class="fa fa-video-camera"></i><strong>{{ users|filter(u => u.role == 'responsable de cinema')|length }}</strong><span>Managers</span></twig:Card>
        <twig:Card class="rk-kpi rk-kpi--amber"><i class="fa fa-ticket"></i><strong>{{ users|filter(u => u.role == 'client')|length }}</strong><span>Clients</span></twig:Card>
    </div>

    <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">{{ macros.render_modal_form(form, path('app_users_new'), 'Create User') }}</div>
    </div>

    <twig:Card class="rk-panel">
        <twig:Card:Header tag="h2" class="rk-card__head">
            <span>Account directory</span>
            <a class="rk-textlink" href="{{ path('app_cinemaAdmin_index') }}">Review cinemas <i class="fa fa-arrow-right"></i></a>
        </twig:Card:Header>
        <twig:Card:Body>
            <div class="rk-table-wrap">
                <table class="rk-table">
                    <thead>
                        <tr>
                            <th>{{ knp_pagination_sortable(pagination, 'Name', ['a.prenom','a.nom']) }}</th>
                            <th>{{ knp_pagination_sortable(pagination, 'Email', 'a.email') }}</th>
                            <th>{{ knp_pagination_sortable(pagination, 'Role', 'a.role') }}</th>
                            <th>Phone</th>
                            <th class="rk-actions-head">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in pagination %}
                            <tr>
                                <td>
                                    <div class="rk-cell-title">
                                        <img src="{{ asset(user.photoDeProfil ?? '/img/users/empty.jpg') }}" alt="" loading="lazy">
                                        <strong>{{ user.nom ~ ' ' ~ user.prenom }}</strong>
                                    </div>
                                </td>
                                <td>{{ user.email }}</td>
                                <td>
                                    <twig:Badge color="{{ user.role == 'admin' ? 'danger' : (user.role == 'responsable de cinema' ? 'warning' : 'primary') }}" pill label="{{ user.role }}"></twig:Badge>
                                </td>
                                <td>{{ user.numTelephone }}</td>
                                <td>
                                    <div class="rk-row-actions">
                                        <twig:Button size="sm" outline color="primary" data-bs-toggle="modal" data-bs-target="#user-edit-{{ loop.index0 }}">Edit</twig:Button>
                                        <form method="post" action="{{ path('app_users_delete', {'id': user.id}) }}" id="delete-user-{{ loop.index0 }}" onsubmit="return confirm('Delete this account?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                            <twig:Button size="sm" outline color="danger" type="submit">Delete</twig:Button>
                                        </form>
                                    </div>
                                    <div class="modal fade" id="user-edit-{{ loop.index0 }}" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            {% if formUpdateNumber is not defined or loop.index0 != formUpdateNumber %}
                                                {{ macros.render_modal_form(updateForms[loop.index0], path('app_users_edit', {'id': user.id, 'formUpdateNumber': loop.index0}), 'Edit User') }}
                                            {% else %}
                                                {{ macros.render_modal_form(updateform, path('app_users_edit', {'id': user.id, 'formUpdateNumber': loop.index0}), 'Edit User') }}
                                            {% endif %}
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="rk-empty-cell">No accounts found.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <nav class="rk-pagination" aria-label="User pages">
                {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
            </nav>
        </twig:Card:Body>
    </twig:Card>

    {% if hasErrorsCreate is defined %}<script>new bootstrap.Modal('#staticBackdrop', {keyboard: false}).show();</script>{% endif %}
    {% if formUpdateNumber is defined %}<script>new bootstrap.Modal('#user-edit-{{ formUpdateNumber }}', {keyboard: false}).show();</script>{% endif %}
{% endblock %}
