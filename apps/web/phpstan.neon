# PHPStan configuration for the Symfony/Twig web app.
# A baseline (phpstan-baseline.neon) freezes pre-existing legacy errors so new
# code is held to the bar without forcing a big-bang cleanup. Regenerate with:
#   vendor/bin/phpstan analyse --generate-baseline
includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
    excludePaths:
        - src/Kernel.php
    # The application kernel deliberately keeps its runtime cache outside the
    # repository, so PHPStan must read the warmed container from that location.
    symfony:
        containerXmlPath: /tmp/cache/dev/App_KernelDevDebugContainer.xml
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
