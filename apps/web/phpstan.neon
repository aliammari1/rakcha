# PHPStan configuration for the Symfony/Twig web app.
# A baseline (phpstan-baseline.neon) freezes pre-existing legacy errors so new
# code is held to the bar without forcing a big-bang cleanup. Regenerate with:
#   vendor/bin/phpstan analyse --generate-baseline
includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
    excludePaths:
        - src/Kernel.php
    # phpstan-symfony container xml — generated by `cache:warmup` in CI.
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
